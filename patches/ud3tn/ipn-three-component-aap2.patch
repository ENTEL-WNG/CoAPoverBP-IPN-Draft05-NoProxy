+TEST(bundle7Serializer, ipn3_roundtrip)
+{
+    const char *original_eid = "ipn:1.3.64";
+
+    const uint8_t expected_cbor[] = {
+        0x82, 0x02, 0x83, 0x01, 0x03, 0x18, 0x40
+    };
+
+    size_t length = 0;
+
+    // 1. Encode the textual IPN address into CBOR.
+    uint8_t *encoded = bundle7_eid_serialize_alloc(
+        original_eid, &length);
+
+    TEST_ASSERT_NOT_NULL(encoded);
+
+    // 2. Check that the CBOR bytes are exactly correct.
+    TEST_ASSERT_EQUAL(sizeof(expected_cbor), length);
+    TEST_ASSERT_EQUAL_UINT8_ARRAY(
+        expected_cbor, encoded, sizeof(expected_cbor));
+
+    // 3. Decode those bytes back into text.
+    char *decoded = bundle7_eid_parse(encoded, length);
+
+    TEST_ASSERT_NOT_NULL(decoded);
+
+    // 4. Check that the address survived the round trip.
+    TEST_ASSERT_EQUAL_STRING(original_eid, decoded);
+
+    free(decoded);
+    free(encoded);
+}
